# BatSignal — configuració del desplegament Docker.
# ./batsignal.sh crea el .env automàticament amb contrasenyes aleatòries; només cal tocar-lo per canviar valors.

# Port del servidor on s'obrirà el panell (http://IP_DEL_SERVIDOR:PORT)
WEB_PORT=8080

# Accés per domini (opcional, es configura des del menú → 10) Configuració → Domini).
# DOMAIN buit = només s'hi accedeix per IP:port. DOMAIN_TLS: "off" (HTTP pla,
# per a dominis interns) o "auto" (HTTPS automàtic amb Let's Encrypt; el domini
# ha de tenir DNS públic apuntant a aquest servidor i els ports 80/443 lliures).
DOMAIN=
DOMAIN_TLS=off
HTTP_PORT=80
HTTPS_PORT=443

# Zona horària (afecta horaris del panell i dels correus)
TZ=Europe/Madrid

# Contrasenyes de la base de dades (generades automàticament; no les canviïs un cop instal·lat)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Opcional: URL de "push" d'un monitor extern (p. ex. Uptime Kuma) que rep un senyal cada minut
HEARTBEAT_URL=

# Còpies de seguretat a conservar
BACKUP_KEEP=14
